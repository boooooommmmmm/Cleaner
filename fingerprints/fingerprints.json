      "detect": { "anyOf": [ { "installedName": "微信" }, { "installedName": "WeChat" }, { "registry": "HKCU\\Software\\Tencent\\WeChat" }, { "installedName": "Weixin" } ] },
      "flags": ["loginState"],
      "note": "Documents 下的 WeChat Files 是聊天记录与接收的文件，删除不可恢复（隔离期外）。"
    },
    {
