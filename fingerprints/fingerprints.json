{
  "version": 1,
  "fingerprints": [
    {
      "id": "gradle", "app": "Gradle", "publisher": "Gradle Inc.",
      "paths": ["%UserProfile%\\.gradle"],
      "detect": { "anyOf": [ { "command": "gradle" }, { "installedName": "Android Studio" }, { "installedName": "IntelliJ IDEA" }, { "directory": "%LocalAppData%\\Programs\\Android Studio" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.gradle\\caches", "%UserProfile%\\.gradle\\daemon", "%UserProfile%\\.gradle\\wrapper\\dists", "%UserProfile%\\.gradle\\native"],
      "note": "Gradle 用户目录。caches / daemon / wrapper 可在保留配置的前提下清理。"
    },
    {
      "id": "maven", "app": "Apache Maven", "publisher": "Apache",
      "paths": ["%UserProfile%\\.m2"],
      "detect": { "anyOf": [ { "command": "mvn" }, { "installedName": "IntelliJ IDEA" }, { "installedName": "Eclipse" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.m2\\repository"],
      "note": "Maven 本地仓库。删除后下次构建重新下载依赖。settings.xml 保留。"
    },
    {
      "id": "nuget", "app": "NuGet", "publisher": "Microsoft",
      "paths": ["%UserProfile%\\.nuget"],
      "detect": { "anyOf": [ { "command": "dotnet" }, { "installedPublisher": "Microsoft Visual Studio" }, { "installedName": "Visual Studio" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.nuget\\packages"],
      "note": "NuGet 全局包缓存。删除后下次还原重新下载。"
    },
    {
      "id": "dotnet-user", "app": ".NET SDK", "publisher": "Microsoft",
      "paths": ["%UserProfile%\\.dotnet", "%UserProfile%\\.templateengine"],
      "detect": { "anyOf": [ { "command": "dotnet" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.dotnet\\TelemetryStorageService", "%UserProfile%\\.templateengine\\packages"],
      "note": ".NET SDK 用户数据：工具、模板缓存、遥测。"
    },
    {
      "id": "android-sdk", "app": "Android SDK", "publisher": "Google",
      "paths": ["%UserProfile%\\.android", "%LocalAppData%\\Android\\Sdk"],
      "detect": { "anyOf": [ { "installedName": "Android Studio" }, { "directory": "%LocalAppData%\\Programs\\Android Studio" }, { "command": "adb" } ] },
      "flags": ["devCache", "programBody"],
      "cachePaths": ["%UserProfile%\\.android\\cache", "%UserProfile%\\.android\\build-cache"],
      "note": "Android SDK 与 AVD 镜像体积很大；SDK 目录属于程序本体，删除后需重新下载。"
    },
    {
      "id": "docker-desktop", "app": "Docker Desktop", "publisher": "Docker Inc.",
      "paths": ["%UserProfile%\\.docker", "%AppData%\\Docker", "%AppData%\\Docker Desktop", "%LocalAppData%\\Docker"],
      "detect": { "anyOf": [ { "installedName": "Docker Desktop" }, { "command": "docker" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%LocalAppData%\\Docker\\log"],
      "note": "Docker Desktop 配置与日志。WSL 虚拟磁盘（ext4.vhdx）只显示体积，不删除。"
    },
    {
      "id": "cargo", "app": "Rust (cargo / rustup)", "publisher": "Rust Foundation",
      "paths": ["%UserProfile%\\.cargo", "%UserProfile%\\.rustup"],
      "detect": { "anyOf": [ { "command": "cargo" }, { "command": "rustup" } ] },
      "flags": ["devCache", "programBody"],
      "cachePaths": ["%UserProfile%\\.cargo\\registry\\cache", "%UserProfile%\\.cargo\\registry\\src", "%UserProfile%\\.cargo\\git\\checkouts", "%UserProfile%\\.rustup\\downloads", "%UserProfile%\\.rustup\\tmp"],
      "note": ".cargo/bin 与 .rustup/toolchains 是工具链本体。"
    },
    {
      "id": "go", "app": "Go", "publisher": "Google",
      "paths": ["%UserProfile%\\go"],
      "detect": { "anyOf": [ { "command": "go" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\go\\pkg\\mod\\cache"],
      "note": "GOPATH。pkg\\mod 是模块缓存，bin 与 src 是用户内容。"
    },
    {
      "id": "conda", "app": "Anaconda / Miniconda", "publisher": "Anaconda, Inc.",
      "paths": ["%UserProfile%\\.conda", "%UserProfile%\\anaconda3", "%UserProfile%\\miniconda3", "%UserProfile%\\.condarc"],
      "detect": { "anyOf": [ { "command": "conda" }, { "installedName": "Anaconda" }, { "installedName": "Miniconda" } ] },
      "flags": ["devCache", "programBody"],
      "cachePaths": ["%UserProfile%\\anaconda3\\pkgs", "%UserProfile%\\miniconda3\\pkgs", "%UserProfile%\\.conda\\pkgs"],
      "note": "pkgs 是包缓存，envs 是用户环境。"
    },
    {
      "id": "python-user", "app": "Python (用户安装)", "publisher": "Python Software Foundation",
      "paths": ["%LocalAppData%\\Programs\\Python", "%AppData%\\Python"],
      "detect": { "anyOf": [ { "installedPublisher": "Python Software Foundation" }, { "command": "python" } ] },
      "flags": ["programBody"],
      "note": "%AppData%\\Python 含 pip --user 安装的包。"
    },
    {
      "id": "jupyter", "app": "Jupyter / IPython", "publisher": "Project Jupyter",
      "paths": ["%UserProfile%\\.ipython", "%UserProfile%\\.jupyter", "%AppData%\\jupyter"],
      "detect": { "anyOf": [ { "command": "jupyter" }, { "command": "ipython" }, { "command": "conda" } ] },
      "note": "内含 notebook 检查点与内核配置。"
    },
    {
      "id": "npm-user", "app": "npm / Node.js", "publisher": "OpenJS Foundation",
      "paths": ["%AppData%\\npm", "%UserProfile%\\.npm", "%UserProfile%\\.npmrc"],
      "detect": { "anyOf": [ { "command": "npm" }, { "command": "node" }, { "installedName": "Node.js" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.npm\\_cacache", "%UserProfile%\\.npm\\_logs"],
      "note": "%AppData%\\npm 是全局安装的包。"
    },
    {
      "id": "pnpm", "app": "pnpm", "publisher": "pnpm",
      "paths": ["%LocalAppData%\\pnpm"],
      "detect": { "anyOf": [ { "command": "pnpm" } ] },
      "flags": ["devCache", "programBody"],
      "cachePaths": ["%LocalAppData%\\pnpm\\store"],
      "note": "store 是内容寻址仓库，删除后项目需重新安装依赖。"
    },
    {
      "id": "cypress", "app": "Cypress", "publisher": "Cypress.io",
      "paths": ["%LocalAppData%\\Cypress"],
      "detect": { "anyOf": [ { "command": "npm" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%LocalAppData%\\Cypress\\Cache"],
      "note": "Cypress 二进制缓存，每个版本数百 MB。"
    },
    {
      "id": "playwright", "app": "Playwright", "publisher": "Microsoft",
      "paths": ["%LocalAppData%\\ms-playwright"],
      "detect": { "anyOf": [ { "command": "npm" }, { "command": "dotnet" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%LocalAppData%\\ms-playwright"],
      "note": "Playwright 浏览器二进制，运行 playwright install 可重新下载。"
    },
    {
      "id": "puppeteer", "app": "Puppeteer", "publisher": "Google",
      "paths": ["%UserProfile%\\.cache\\puppeteer"],
      "detect": { "anyOf": [ { "command": "npm" } ] },
      "flags": ["devCache"],
      "cachePaths": ["%UserProfile%\\.cache\\puppeteer"],
      "note": "Puppeteer 下载的 Chromium。"
    },
    {
      "id": "vscode-user", "app": "Visual Studio Code", "publisher": "Microsoft",
      "paths": ["%UserProfile%\\.vscode", "%UserProfile%\\.vscode-insiders", "%AppData%\\Code - Insiders"],
      "detect": { "anyOf": [ { "file": "%LocalAppData%\\Programs\\Microsoft VS Code\\Code.exe" }, { "file": "%ProgramFiles%\\Microsoft VS Code\\Code.exe" }, { "installedName": "Microsoft Visual Studio Code" }, { "file": "%LocalAppData%\\Programs\\Microsoft VS Code Insiders\\Code - Insiders.exe" } ] },
      "note": "扩展目录。VS Code 主配置由规则库 microsoft.vscode 处理。"
    },
    {
      "id": "jetbrains", "app": "JetBrains IDE", "publisher": "JetBrains",
      "paths": ["%AppData%\\JetBrains", "%LocalAppData%\\JetBrains"],
      "detect": { "anyOf": [ { "installedPublisher": "JetBrains" }, { "directory": "%LocalAppData%\\Programs\\IntelliJ IDEA" }, { "registry": "HKCU\\Software\\JetBrains" } ] },
      "flags": ["license", "devCache"],
      "cachePaths": ["%LocalAppData%\\JetBrains"],
      "note": "%AppData%\\JetBrains 含 IDE 配置、密钥与许可证；%LocalAppData%\\JetBrains 是索引缓存，可在保留配置的前提下清理。"
    },
    {
      "id": "adobe", "app": "Adobe Creative Cloud", "publisher": "Adobe",
      "paths": ["%AppData%\\Adobe", "%LocalAppData%\\Adobe"],
      "detect": { "anyOf": [ { "installedPublisher": "Adobe" }, { "directory": "%ProgramFiles%\\Adobe" }, { "directory": "%ProgramFilesX86%\\Adobe" } ] },
      "flags": ["license"],
      "note": "含 Creative Cloud 登录与许可证缓存；重装后需重新登录。"
    },
    {
      "id": "autodesk", "app": "Autodesk", "publisher": "Autodesk",
      "paths": ["%AppData%\\Autodesk", "%LocalAppData%\\Autodesk"],
      "detect": { "anyOf": [ { "installedPublisher": "Autodesk" }, { "directory": "%ProgramFiles%\\Autodesk" } ] },
      "flags": ["license"],
      "note": "含许可证与自定义配置。"
    },
    {
      "id": "unity", "app": "Unity", "publisher": "Unity Technologies",
      "paths": ["%AppData%\\Unity", "%LocalAppData%\\Unity", "%AppData%\\UnityHub", "%LocalAppData%\\UnityHub"],
      "detect": { "anyOf": [ { "installedName": "Unity Hub" }, { "installedPublisher": "Unity Technologies" } ] },
      "flags": ["license", "devCache"],
      "cachePaths": ["%LocalAppData%\\Unity\\cache"],
      "note": "%AppData%\\Unity 含许可证文件。"
    },
    {
      "id": "epic-games", "app": "Epic Games Launcher", "publisher": "Epic Games",
      "paths": ["%LocalAppData%\\EpicGamesLauncher", "%LocalAppData%\\UnrealEngine", "%LocalAppData%\\UnrealEngineLauncher"],
      "detect": { "anyOf": [ { "installedName": "Epic Games Launcher" }, { "directory": "%ProgramFilesX86%\\Epic Games\\Launcher" } ] },
      "flags": ["gameSaves"],
      "note": "部分游戏把存档放在 %LocalAppData% 的对应目录下。"
    },
    {
      "id": "zoom", "app": "Zoom", "publisher": "Zoom Video Communications",
      "paths": ["%AppData%\\Zoom"],
      "detect": { "anyOf": [ { "installedName": "Zoom" }, { "file": "%AppData%\\Zoom\\bin\\Zoom.exe" } ] },
      "flags": ["loginState"],
      "note": "Zoom 用户级安装的程序本体也在这里。"
    },
    {
