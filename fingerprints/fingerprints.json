      "detect": { "anyOf": [ { "installedName": "QQ" }, { "registry": "HKCU\\Software\\Tencent\\QQ" }, { "registry": "HKCU\\Software\\Tencent\\QQNT" } ] },
      "flags": ["loginState"],
      "note": "Documents 下的 Tencent Files 是聊天记录与接收的文件。"
    },
    {
      "id": "dingtalk", "app": "钉钉", "publisher": "Alibaba",
      "paths": ["%AppData%\\DingTalk", "%LocalAppData%\\DingTalk"],
      "detect": { "anyOf": [ { "installedName": "钉钉" }, { "installedName": "DingTalk" } ] },
      "flags": ["loginState"]
    },
    {
      "id": "feishu", "app": "飞书 / Lark", "publisher": "ByteDance",
      "paths": ["%AppData%\\Feishu", "%AppData%\\LarkShell", "%LocalAppData%\\Feishu", "%LocalAppData%\\LarkShell"],
      "detect": { "anyOf": [ { "installedName": "飞书" }, { "installedName": "Feishu" }, { "installedName": "Lark" } ] },
      "flags": ["loginState"]
    },
