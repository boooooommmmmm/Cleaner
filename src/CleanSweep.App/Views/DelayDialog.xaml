<Window x:Class="CleanSweep.App.Views.DelayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="延迟启动" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}" FontFamily="Segoe UI, Microsoft YaHei UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,8,0,0"
                   Text="登录后先让系统和常用程序就位，再启动这个程序。会创建一个计划任务（任务计划程序 → CleanSweep 文件夹），原启动项禁用但不删除；删除该任务并重新启用原项即可撤销。"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <TextBlock Text="登录后延迟" VerticalAlignment="Center"/>
            <ComboBox x:Name="DelayBox" Width="120" Margin="10,0" SelectedIndex="1" AutomationProperties.Name="延迟时长">
                <ComboBoxItem Content="30 秒" Tag="30"/>
                <ComboBoxItem Content="1 分钟" Tag="60"/>
                <ComboBoxItem Content="2 分钟" Tag="120"/>
                <ComboBoxItem Content="5 分钟" Tag="300"/>
                <ComboBoxItem Content="10 分钟" Tag="600"/>
            </ComboBox>
            <TextBlock Text="启动" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" IsCancel="True" MinWidth="80"/>
            <Button Content="确定" Style="{StaticResource Button.Primary}" IsDefault="True" MinWidth="80" Margin="8,0,0,0" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
