<Window x:Class="CleanSweep.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CleanSweep.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="CleanSweep · Windows 系统清理"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                    <TextBlock Text="CleanSweep" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="安全优先的系统清理" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,16">
                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding Elevation.StatusText}" Style="{StaticResource Text.Secondary}"/>
                    <TextBlock Text="{Binding UpdateNotice}" Foreground="{StaticResource Brush.Accent}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding UpdateNotice, Converter={StaticResource NullToVis}}"/>
                    <Button Content="以管理员身份重新启动" Style="{StaticResource Button.Link}" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0"
                            Command="{Binding RelaunchElevatedCommand}"
                            Visibility="{Binding Elevation.IsElevated, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </StackPanel>

                <!-- 固定在底部、始终可见的项：隔离区（后悔药）与设置 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,6">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="16,4,16,6"/>
                    <ItemsControl ItemsSource="{Binding PinnedItems}" ItemTemplate="{StaticResource Nav.ItemTemplate}"/>
                </StackPanel>

                <!-- 分组的导航列表：组标题可折叠，列表自己滚动，顶部标题与底部区域固定 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavGroup}">
                                <StackPanel>
                                    <ToggleButton Style="{StaticResource Nav.GroupHeader}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding AutomationName}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CollapsedHint}" Style="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </ToggleButton>
                                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Nav.ItemTemplate}"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <ContentControl Grid.Column="1" Content="{Binding Selected.Page}"/>
    </Grid>
</Window>
