{
  "version": 1,
  "rules": [
    {
      "id": "windows.temp",
      "app": "Windows 临时文件",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%Temp%", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "当前用户临时目录（仅 24 小时前的文件，正在使用的临时文件不会被触碰）", "minAgeDays": 1 },
        { "path": "%Windir%\\Temp", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "系统临时目录（仅 24 小时前的文件）", "minAgeDays": 1 },
        { "path": "%Windir%\\SystemTemp", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "系统临时目录（Windows 11，仅 24 小时前的文件）", "minAgeDays": 1 },
        { "path": "%Windir%\\ServiceProfiles\\LocalService\\AppData\\Local\\Temp", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "本地服务账户临时目录（仅 24 小时前的文件）", "minAgeDays": 1 },
        { "path": "%Windir%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Temp", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "网络服务账户临时目录（仅 24 小时前的文件）", "minAgeDays": 1 }
      ]
    },
    {
      "id": "windows.explorer-cache",
      "app": "资源管理器缓存",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%LocalAppData%\\Microsoft\\Windows\\Explorer", "pattern": "thumbcache_*.db;iconcache_*.db", "recurse": false, "risk": "safe", "when": "always", "description": "缩略图与图标缓存，删除后系统自动重建" }
      ]
    },
    {
      "id": "windows.error-reports",
      "app": "错误报告与日志",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%ProgramData%\\Microsoft\\Windows\\WER", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "Windows 错误报告（系统级）" },
        { "path": "%LocalAppData%\\Microsoft\\Windows\\WER", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "Windows 错误报告（当前用户）" },
        { "path": "%Windir%\\Logs\\CBS", "pattern": "*.log;*.cab", "recurse": false, "risk": "safe", "when": "always", "description": "组件服务（CBS）日志" },
        { "path": "%Windir%\\Logs\\DISM", "pattern": "*.log", "recurse": false, "risk": "safe", "when": "always", "description": "DISM 日志" },
        { "path": "%Windir%\\Logs\\WindowsUpdate", "pattern": "*.etl", "recurse": false, "risk": "safe", "when": "always", "description": "Windows 更新跟踪日志" }
      ]
    },
    {
      "id": "windows.crash-dumps",
      "app": "内存转储",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%Windir%\\Minidump", "pattern": "*.dmp", "recurse": false, "risk": "safe", "when": "always", "description": "蓝屏小型转储。若正在排查蓝屏问题请保留" },
        { "path": "%Windir%\\LiveKernelReports", "pattern": "*.dmp", "recurse": true, "risk": "safe", "when": "always", "description": "内核实时报告转储" },
        { "path": "%Windir%\\MEMORY.DMP", "risk": "safe", "when": "always", "description": "完整内存转储。若正在排查蓝屏问题请保留" }
      ]
    },
    {
      "id": "windows.update-cache",
      "app": "Windows 更新缓存",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%Windir%\\SoftwareDistribution\\Download", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "已下载的更新安装包，清理后如有需要会重新下载", "preActions": ["stopService:wuauserv", "stopService:bits"] },
        { "path": "%Windir%\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\Cache", "pattern": "*", "recurse": true, "risk": "safe", "when": "always", "description": "传递优化缓存", "preActions": ["stopService:DoSvc"] }
      ]
    },
    {
      "id": "windows.previous-installation",
      "app": "旧版 Windows 安装",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%SystemDrive%\\Windows.old", "kind": "directory", "risk": "confirm", "when": "always", "description": "上一版本 Windows。删除后将无法回退到上一个版本" },
        { "path": "%SystemDrive%\\$WinREAgent", "kind": "directory", "risk": "confirm", "when": "always", "description": "更新过程中的恢复环境暂存。更新进行中时请勿删除" }
      ]
    },
    {
      "id": "windows.recycle-bin",
      "app": "回收站",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "kind": "recycleBin", "risk": "confirm", "when": "always", "description": "清空所有磁盘的回收站" }
      ]
    },
    {
      "id": "windows.component-store",
      "app": "组件存储（WinSxS）",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "kind": "command", "command": "dism.exe", "args": "/Online /Cleanup-Image /StartComponentCleanup", "risk": "confirm", "when": "always", "description": "清理被替换的组件版本。执行后已安装的更新将无法卸载，耗时数分钟" }
      ]
    },
    {
      "id": "windows.prefetch",
      "app": "预读取（Prefetch）",
      "publisher": "Microsoft",
      "category": "system",
      "targets": [
        { "path": "%Windir%\\Prefetch", "pattern": "*.pf", "recurse": false, "risk": "not-recommended", "when": "always", "description": "预读取数据。清空后系统需重新学习，短期内程序启动会变慢" }
      ]
    }
  ]
}
